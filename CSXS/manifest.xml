<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.sfxstudio.panel" ExtensionBundleVersion="1.0.0" ExtensionBundleName="SFX Studio" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<ExtensionList>
		<Extension Id="com.sfxstudio.panel.extension" Version="1.0.0"/>
	</ExtensionList>
	<ExecutionEnvironment>
		<HostList>
			<!-- Premiere Pro -->
			<Host Name="PPRO" Version="[11.0,99.9]"/>
		</HostList>
		<LocaleList>
			<Locale Code="All"/>
		</LocaleList>
		<RequiredRuntimeList>
			<RequiredRuntime Name="CSXS" Version="7.0"/>
		</RequiredRuntimeList>
	</ExecutionEnvironment>
	<DispatchInfoList>
		<Extension Id="com.sfxstudio.panel.extension">
			<DispatchInfo>
				<Resources>
					<MainPath>./dist/index.html</MainPath>
					<ScriptPath>./jsx/extendscript.jsx</ScriptPath>
					<CEFCommandLine>
						<Parameter>--enable-nodejs</Parameter>
						<Parameter>--mixed-context</Parameter>
					</CEFCommandLine>
				</Resources>
				<Lifecycle>
					<AutoVisible>true</AutoVisible>
				</Lifecycle>
				<UI>
					<Type>Panel</Type>
					<Menu>SFX Studio</Menu>
					<Geometry>
						<Size>
							<Height>600</Height>
							<Width>400</Width>
						</Size>
						<MinSize>
							<Height>400</Height>
							<Width>300</Width>
						</MinSize>
					</Geometry>
				</UI>
			</DispatchInfo>
		</Extension>
	</DispatchInfoList>
</ExtensionManifest>
